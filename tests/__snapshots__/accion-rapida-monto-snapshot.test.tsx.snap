// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`DepositarRapido / PagarDiferenciaRapido — snapshot antes de useAccionRapidaMonto > DepositarRapido (mi propia plata) — hoja abierta 1`] = `"<button type="button" class="inline-flex min-h-11 w-full shrink-0 items-center justify-center rounded-xl border border-[#d0cec8] bg-surface px-4 text-center text-[15px] font-semibold text-text transition-colors hover:bg-background disabled:opacity-45 sm:w-auto">Pasar a la cuenta</button><div role="dialog" aria-modal="true" aria-label="Pasar a la cuenta" class="fixed inset-0 z-50 flex items-end justify-center bg-scrim sm:items-center"><div class="rounded-t-2xl bg-surface sm:rounded-2xl max-h-[85dvh] w-full overflow-y-auto overscroll-contain border-t-2 px-5 py-[22px] sm:max-w-sm border-mark"><h2 class="font-display text-[24px] break-words text-text">Pasar a la cuenta</h2><p class="mt-1 text-[16px] text-text-muted">Registrá cuánto de la plata que tenés en mano ($ 1.500,00) ya está en la cuenta de Ananja. Fecha: 16/09/2026.</p><div class="mt-4 flex flex-col gap-4"><div><label for="deposito-rapido-tenedor-1" class="block text-[15px] font-semibold text-text break-words">Monto</label><div class="mt-1.5 flex min-h-12 items-center gap-2 rounded-xl border border-[#d0cec8] bg-surface px-3 focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/30"><input id="deposito-rapido-tenedor-1" inputmode="decimal" autocomplete="off" required="" class="min-h-14 w-full min-w-0 bg-transparent text-[28px] font-semibold leading-none text-text tabular-nums focus:outline-none" type="text" value="1.500,00"></div><span class="sr-only" aria-live="polite"></span></div><div><span class="text-[15px] font-semibold text-text">Cuenta destino</span><div class="mt-1.5" role="group" aria-label="Medio de pago"><div class="grid gap-px overflow-hidden rounded-xl border border-[#d0cec8] bg-border " style="grid-template-columns: repeat(2, minmax(0, 1fr));"><button type="button" aria-pressed="false" class="min-h-12 px-2 text-[16px] font-medium transition-colors bg-surface-raised text-text">Banco</button><button type="button" aria-pressed="true" class="min-h-12 px-2 text-[16px] font-medium transition-colors bg-primary text-primary-foreground">Mercado Pago</button></div></div></div></div><div class="mt-5 flex gap-2"><button class="min-h-12 items-center justify-center rounded-xl text-center text-[16px] font-semibold transition-colors disabled:opacity-45 bg-primary text-primary-foreground hover:bg-primary-hover active:bg-primary-active flex flex-[1.6] px-4" type="button"><span class="inline-grid items-center justify-items-center"><span class="col-start-1 row-start-1 ">Guardar depósito</span><span class="col-start-1 row-start-1 inline-flex items-center gap-2 invisible"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false" class="h-[1em] w-[1em] shrink-0 animate-spin motion-reduce:animate-none "><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-opacity="0.25" stroke-width="1.5"></circle><path d="M8 1.5a6.5 6.5 0 0 1 6.5 6.5" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>Guardando…</span></span></button><button type="button" class="min-h-12 items-center justify-center rounded-xl text-center text-[16px] font-semibold transition-colors disabled:opacity-45 border border-[#d0cec8] bg-surface text-text hover:bg-background flex flex-1 px-4">Cancelar</button></div><a href="/plata/depositar?tenedor=tenedor-1&amp;monto=150000" class="mt-4 inline-block border-b border-mark text-[14px] text-text">Otra fecha o con nota →</a></div></div>"`;

exports[`DepositarRapido / PagarDiferenciaRapido — snapshot antes de useAccionRapidaMonto > DepositarRapido (plata de otro admin) — hoja abierta 1`] = `"<button type="button" aria-label="Registrar que Marcela pasó su plata a la cuenta" class="inline-flex min-h-11 w-full shrink-0 items-center justify-center rounded-xl border border-[#d0cec8] bg-surface px-4 text-center text-[15px] font-semibold text-text transition-colors hover:bg-background disabled:opacity-45 sm:w-auto">Registrar que lo pasó</button><div role="dialog" aria-modal="true" aria-label="Registrar que Marcela lo pasó" class="fixed inset-0 z-50 flex items-end justify-center bg-scrim sm:items-center"><div class="rounded-t-2xl bg-surface sm:rounded-2xl max-h-[85dvh] w-full overflow-y-auto overscroll-contain border-t-2 px-5 py-[22px] sm:max-w-sm border-mark"><h2 class="font-display text-[24px] break-words text-text">Registrar que Marcela lo pasó</h2><p class="mt-1 text-[16px] text-text-muted">Registrá cuánto de la plata que tiene Marcela en mano ($ 500,00) ya está en la cuenta de Ananja. Fecha: 16/09/2026.</p><div class="mt-4 flex flex-col gap-4"><div><label for="deposito-rapido-tenedor-2" class="block text-[15px] font-semibold text-text break-words">Monto</label><div class="mt-1.5 flex min-h-12 items-center gap-2 rounded-xl border border-[#d0cec8] bg-surface px-3 focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/30"><input id="deposito-rapido-tenedor-2" inputmode="decimal" autocomplete="off" required="" class="min-h-14 w-full min-w-0 bg-transparent text-[28px] font-semibold leading-none text-text tabular-nums focus:outline-none" type="text" value="500,00"></div><span class="sr-only" aria-live="polite"></span></div><div><span class="text-[15px] font-semibold text-text">Cuenta destino</span><div class="mt-1.5" role="group" aria-label="Medio de pago"><div class="grid gap-px overflow-hidden rounded-xl border border-[#d0cec8] bg-border " style="grid-template-columns: repeat(2, minmax(0, 1fr));"><button type="button" aria-pressed="true" class="min-h-12 px-2 text-[16px] font-medium transition-colors bg-primary text-primary-foreground">Banco</button><button type="button" aria-pressed="false" class="min-h-12 px-2 text-[16px] font-medium transition-colors bg-surface-raised text-text">Mercado Pago</button></div></div></div></div><div class="mt-5 flex gap-2"><button class="min-h-12 items-center justify-center rounded-xl text-center text-[16px] font-semibold transition-colors disabled:opacity-45 bg-primary text-primary-foreground hover:bg-primary-hover active:bg-primary-active flex flex-[1.6] px-4" type="button"><span class="inline-grid items-center justify-items-center"><span class="col-start-1 row-start-1 ">Guardar depósito</span><span class="col-start-1 row-start-1 inline-flex items-center gap-2 invisible"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false" class="h-[1em] w-[1em] shrink-0 animate-spin motion-reduce:animate-none "><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-opacity="0.25" stroke-width="1.5"></circle><path d="M8 1.5a6.5 6.5 0 0 1 6.5 6.5" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>Guardando…</span></span></button><button type="button" class="min-h-12 items-center justify-center rounded-xl text-center text-[16px] font-semibold transition-colors disabled:opacity-45 border border-[#d0cec8] bg-surface text-text hover:bg-background flex flex-1 px-4">Cancelar</button></div><a href="/plata/depositar?tenedor=tenedor-2&amp;monto=50000" class="mt-4 inline-block border-b border-mark text-[14px] text-text">Otra fecha o con nota →</a></div></div>"`;
