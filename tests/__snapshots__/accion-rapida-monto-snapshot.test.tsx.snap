exports[`DepositarRapido / PagarDiferenciaRapido — snapshot antes de useAccionRapidaMonto > DepositarRapido (mi propia plata) — hoja abierta 1`] = `"<button type="button" class="flex min-h-11 shrink-0 items-center justify-center px-4 text-xs font-medium tracking-[0.12em] uppercase transition-colors bg-primary text-background hover:bg-primary-hover">Pasar a la cuenta</button><div role="dialog" aria-modal="true" aria-label="Pasar a la cuenta" class="fixed inset-0 z-50 flex items-end justify-center bg-scrim sm:items-center"><div class="paper-texture max-h-[85dvh] w-full overflow-y-auto overscroll-contain border-t-2 px-5 py-[22px] sm:max-w-sm border-mark"><h2 class="font-display text-[24px] break-words text-primary">Pasar a la cuenta</h2><p class="mt-1 text-[13px] text-text-muted">Registrá cuánto de la plata que tenés en mano ($ 1.500,00) ya está en la cuenta de Ananja. Fecha: 16/09/2026.</p><div class="mt-4 flex flex-col gap-4"><div><label for="deposito-rapido-tenedor-1" class="text-[10px] tracking-[0.18em] text-text-muted uppercase">Monto</label><div class="mt-1 flex border-b-2 border-primary"><input id="deposito-rapido-tenedor-1" inputmode="decimal" autocomplete="off" required="" class="font-display block w-full min-w-0 bg-transparent py-1 text-[32px] text-primary tabular-nums" type="text" value="1.500,00"></div><span class="sr-only" aria-live="polite"></span></div><div><span class="text-[10px] tracking-[0.18em] text-text-muted uppercase">Cuenta destino</span><div class="mt-1.5"><div class="grid gap-px bg-border " style="grid-template-columns: repeat(2, minmax(0, 1fr));"><button type="button" aria-pressed="false" class="min-h-[52px] px-2 text-[13px] font-medium transition-colors bg-surface-raised text-text">Banco</button><button type="button" aria-pressed="true" class="min-h-[52px] px-2 text-[13px] font-medium transition-colors bg-primary text-background">Mercado Pago</button></div></div></div></div><div class="mt-5 flex gap-2"><button class="flex min-h-[52px] flex-[1.6] items-center justify-center bg-primary px-4 text-[13px] font-medium tracking-[0.14em] text-background uppercase hover:bg-primary-hover disabled:opacity-45" type="button"><span class="inline-grid items-center justify-items-center"><span class="col-start-1 row-start-1 ">Guardar depósito</span><span class="col-start-1 row-start-1 inline-flex items-center gap-2 invisible"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false" class="h-[1em] w-[1em] shrink-0 animate-spin motion-reduce:animate-none "><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-opacity="0.25" stroke-width="1.5"></circle><path d="M8 1.5a6.5 6.5 0 0 1 6.5 6.5" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>Guardando…</span></span></button><button type="button" class="flex min-h-[52px] flex-1 items-center justify-center border border-border px-4 text-[13px] font-medium tracking-[0.14em] text-text-muted uppercase disabled:opacity-45">Cancelar</button></div><a href="/plata/depositar?tenedor=tenedor-1&amp;monto=150000" class="mt-4 inline-block border-b border-mark text-[11px] tracking-[0.12em] text-text uppercase">Otra fecha o con nota →</a></div></div>"`;

exports[`DepositarRapido / PagarDiferenciaRapido — snapshot antes de useAccionRapidaMonto > DepositarRapido (plata de otro admin) — hoja abierta 1`] = `"<button type="button" aria-label="Registrar que Marcela pasó su plata a la cuenta" class="flex min-h-11 shrink-0 items-center justify-center px-4 text-xs font-medium tracking-[0.12em] uppercase transition-colors bg-background text-primary hover:bg-surface-raised">Registrar que lo pasó</button><div role="dialog" aria-modal="true" aria-label="Registrar que Marcela lo pasó" class="fixed inset-0 z-50 flex items-end justify-center bg-scrim sm:items-center"><div class="paper-texture max-h-[85dvh] w-full overflow-y-auto overscroll-contain border-t-2 px-5 py-[22px] sm:max-w-sm border-mark"><h2 class="font-display text-[24px] break-words text-primary">Registrar que Marcela lo pasó</h2><p class="mt-1 text-[13px] text-text-muted">Registrá cuánto de la plata que tiene Marcela en mano ($ 500,00) ya está en la cuenta de Ananja. Fecha: 16/09/2026.</p><div class="mt-4 flex flex-col gap-4"><div><label for="deposito-rapido-tenedor-2" class="text-[10px] tracking-[0.18em] text-text-muted uppercase">Monto</label><div class="mt-1 flex border-b-2 border-primary"><input id="deposito-rapido-tenedor-2" inputmode="decimal" autocomplete="off" required="" class="font-display block w-full min-w-0 bg-transparent py-1 text-[32px] text-primary tabular-nums" type="text" value="500,00"></div><span class="sr-only" aria-live="polite"></span></div><div><span class="text-[10px] tracking-[0.18em] text-text-muted uppercase">Cuenta destino</span><div class="mt-1.5"><div class="grid gap-px bg-border " style="grid-template-columns: repeat(2, minmax(0, 1fr));"><button type="button" aria-pressed="true" class="min-h-[52px] px-2 text-[13px] font-medium transition-colors bg-primary text-background">Banco</button><button type="button" aria-pressed="false" class="min-h-[52px] px-2 text-[13px] font-medium transition-colors bg-surface-raised text-text">Mercado Pago</button></div></div></div></div><div class="mt-5 flex gap-2"><button class="flex min-h-[52px] flex-[1.6] items-center justify-center bg-primary px-4 text-[13px] font-medium tracking-[0.14em] text-background uppercase hover:bg-primary-hover disabled:opacity-45" type="button"><span class="inline-grid items-center justify-items-center"><span class="col-start-1 row-start-1 ">Guardar depósito</span><span class="col-start-1 row-start-1 inline-flex items-center gap-2 invisible"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false" class="h-[1em] w-[1em] shrink-0 animate-spin motion-reduce:animate-none "><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-opacity="0.25" stroke-width="1.5"></circle><path d="M8 1.5a6.5 6.5 0 0 1 6.5 6.5" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>Guardando…</span></span></button><button type="button" class="flex min-h-[52px] flex-1 items-center justify-center border border-border px-4 text-[13px] font-medium tracking-[0.14em] text-text-muted uppercase disabled:opacity-45">Cancelar</button></div><a href="/plata/depositar?tenedor=tenedor-2&amp;monto=50000" class="mt-4 inline-block border-b border-mark text-[11px] tracking-[0.12em] text-text uppercase">Otra fecha o con nota →</a></div></div>"`;
